<template>
    <SiteShell page="home">
        <section class="hero">
            <div class="hero__copy">
                <span class="tag">In development · no public release</span>
                <h1>
                    Two-dimensional flow that stays verifiable —<br />from case to residual.
                </h1>
                <p class="hero__sub">
                    OpenCFD is a narrowly scoped, verifiable incompressible
                    Navier-Stokes solver. One Rust session owns the `.ocfd`
                    document, validation, the staggered-mesh solve and field
                    export; the CLI and the TypeScript SDK are thin wrappers over
                    the same core. Cavity and channel cases, solid obstacles,
                    passive scalar transport and steady-state detection work
                    today. Three-dimensional flow, compressible flow, Boussinesq
                    buoyancy and adaptive meshing are explicitly unsupported.
                </p>
                <div class="hero__cta">
                    <Link to="FeaturesPage" class="btn btn--primary">
                        See what works
                    </Link>
                    <Link to="RoadmapPage" class="btn btn--ghost">
                        Read the roadmap
                    </Link>
                </div>
            </div>

            <div class="solver-frame" aria-hidden="true">
                <div class="sf-titlebar">
                    <span class="sf-mark">O</span>
                    <span class="sf-name">ocfd</span>
                    <span class="sf-doc">demo.ocfd</span>
                    <span class="sf-rev">preview</span>
                </div>
                <div class="sf-toolbar">
                    <span class="sf-block sf-block--wide"></span>
                    <span class="sf-block"></span>
                    <span class="sf-block"></span>
                    <span class="sf-block"></span>
                    <span class="sf-block sf-block--wide"></span>
                </div>
