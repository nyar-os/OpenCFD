                        <span class="sf-rail-item">steps 200</span>
                        <span class="sf-rail-head">Export</span>
                        <span class="sf-rail-item">CSV</span>
                        <span class="sf-rail-item">VTK</span>
                        <span class="sf-rail-item">SVG</span>
                    </div>
                    <div class="sf-canvas">
                        <div class="sf-terminal">
                            <span class="sf-prompt">$ ocfd solve demo.ocfd --tolerance 1e-4</span>
                            <span class="sf-line">steps              <b>200</b></span>
                            <span class="sf-line">maxVelocity        <b>0.8352</b></span>
                            <span class="sf-line">minPressure        <b>-0.1866</b></span>
                            <span class="sf-line">maxPressure        <b>0.4767</b></span>
                            <span class="sf-line">divergenceL2       <b>3.48e-4</b></span>
