<script client>
const FORMATS = ["ocfd", "csv", "vtk", "svg", "openfoam", "inp"];

export default class IndexPage {
    static meta() {
        return {
            title: "OpenCFD — verifiable two-dimensional incompressible flow",
            description:
                "OpenCFD keeps one case model with working create, edit, validate, solve and CSV/VTK/SVG export for two-dimensional incompressible flow, while 3D, compressible flow and buoyancy stay clearly marked as unsupported.",
        };
    }

    formatRows() {
        const declared = {
            ocfd: { readState: "supported", writeState: "supported" },
            csv: { readState: "unsupported", writeState: "supported" },
            vtk: { readState: "unsupported", writeState: "supported" },
            svg: { readState: "unsupported", writeState: "supported" },
        };
        return FORMATS.map((name) => {
            const row =
                declared[name] || { readState: "unsupported", writeState: "unsupported" };
            const status =
                row.readState === "supported" && row.writeState === "supported"
                    ? "read + write"
                    : row.writeState === "supported"
                      ? "write only"
                      : "unsupported";
            return Object.assign({ name, status }, row);
        });
    }

    statusClass(row) {
        return row.status === "unsupported" ? "chip chip--blocked" : "chip chip--available";
    }
}
</script>
